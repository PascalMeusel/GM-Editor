+// GM Editor extension: soft wraps are visual boundaries, never bytes in the
+// user's buffer. Keep whitespace so selection, clipboard, callbacks and undo
+// retain the exact original text. The same rows drive STB hit testing/rendering.
+static const char* InputTextWrappedRowEnd(ImGuiContext& g, const char* begin, const char* end, float width)
+{
+    const char* blank = NULL;
+    float x = 0.0f;
+    for (const char* p = begin; p < end; )
+    {
+        unsigned int c;
+        const char* next = p + ImTextCharFromUtf8(&c, p, end);
+        if (next <= p) next = p + 1;
+        if (c == '\n') return next;
+        const float advance = c == '\r' ? 0.0f : g.FontBaked->GetCharAdvance((ImWchar)c) * g.FontBakedScale;
+        if (x + advance > width && p > begin) return blank ? blank : p;
+        x += advance;
+        if (c == ' ' || c == '\t') blank = next;
+        p = next;
+    }
+    return end;
+}
+
+static ImVec2 InputTextWrappedOffset(ImGuiContext& g, const char* begin, const char* end, const char* cursor, float width, int* line_count = NULL)
+{
+    int row = 1;
+    ImVec2 offset(0, g.FontSize);
+    bool located = false;
+    for (const char* p = begin; ; ++row)
+    {
+        const char* next = InputTextWrappedRowEnd(g, p, end, width);
+        const bool trailing_newline = next > p && next[-1] == '\n';
+        if (!located && (cursor < next || (next == end && !trailing_newline) || p == end))
+        {
+            offset = ImVec2(InputTextCalcTextSize(&g, p, cursor).x, row * g.FontSize);
+            located = true;
+        }
+        if (next == end && !trailing_newline) break;
+        p = next;
+    }
+    if (line_count) *line_count = row;
+    return offset;
+}
+
+static void InputTextRenderWrapped(ImGuiContext& g, ImDrawList* list, ImVec2 origin, ImU32 color, const char* begin, const char* end, float width, const ImVec4& clip)
+{
+    for (const char* p = begin; p < end; origin.y += g.FontSize)
+    {
+        const char* next = InputTextWrappedRowEnd(g, p, end, width);
+        if (origin.y > clip.w) break;
+        if (origin.y + g.FontSize >= clip.y)
+            list->AddText(g.Font, g.FontSize, origin, color, p, next, 0.0f, &clip);
+        p = next;
+    }
+}
