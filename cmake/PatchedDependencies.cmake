# Keep upstream submodules pristine. Local compatibility fixes are reviewable
# patches applied to fingerprinted copies inside the build tree.
find_package(Git REQUIRED)
function(ttrpg_patched_dependency name revision output_variable)
    set(upstream "${CMAKE_CURRENT_SOURCE_DIR}/extern/${name}")
    set(patch "${CMAKE_CURRENT_SOURCE_DIR}/cmake/patches/${name}.patch")
    set(from_source_archive FALSE)
    if(EXISTS "${upstream}/.git")
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${upstream}" rev-parse HEAD
            OUTPUT_VARIABLE actual_revision OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE result)
        if(NOT result EQUAL 0 OR NOT actual_revision STREQUAL revision)
            message(FATAL_ERROR "${name} must be checked out at pinned revision ${revision}; initialize submodules")
        endif()
    elseif(EXISTS "${upstream}/.gm-source-manifest.json")
        # A corresponding-source ZIP intentionally has no Git metadata. Verify
        # every canonical upstream file before making the patched build copy.
        file(READ "${upstream}/.gm-source-manifest.json" source_manifest)
        string(JSON archive_revision GET "${source_manifest}" revision)
        if(NOT archive_revision STREQUAL revision)
            message(FATAL_ERROR "${name} source archive has the wrong revision")
        endif()
        string(JSON file_count LENGTH "${source_manifest}" files)
        if(file_count LESS 1)
            message(FATAL_ERROR "${name} source archive has an empty file inventory")
        endif()
        math(EXPR last_file "${file_count} - 1")
        set(expected_files .gm-source-manifest.json)
        foreach(index RANGE 0 ${last_file})
            string(JSON relative MEMBER "${source_manifest}" files ${index})
            string(JSON expected_hash GET "${source_manifest}" files "${relative}")
            if(IS_ABSOLUTE "${relative}" OR relative MATCHES "(^|/)\\.\\.(/|$)" OR
               IS_SYMLINK "${upstream}/${relative}" OR NOT EXISTS "${upstream}/${relative}")
                message(FATAL_ERROR "${name} source archive contains an unsafe or missing file")
            endif()
            file(SHA256 "${upstream}/${relative}" actual_hash)
            if(NOT actual_hash STREQUAL expected_hash)
                message(FATAL_ERROR "${name} source archive file changed: ${relative}")
            endif()
            list(APPEND expected_files "${relative}")
        endforeach()
        file(GLOB_RECURSE actual_files LIST_DIRECTORIES false RELATIVE "${upstream}" "${upstream}/*")
        list(SORT expected_files)
        list(SORT actual_files)
        if(NOT "${expected_files}" STREQUAL "${actual_files}")
            message(FATAL_ERROR "${name} source archive has files outside its inventory")
        endif()
        set(from_source_archive TRUE)
    else()
        message(FATAL_ERROR "${name} needs its pinned Git submodule or the verified dependency from the source ZIP")
    endif()
    file(SHA256 "${patch}" patch_hash)
    string(SUBSTRING "${patch_hash}" 0 12 fingerprint)
    set(patched "${CMAKE_CURRENT_BINARY_DIR}/_deps/patched-${name}-${fingerprint}")
    if(NOT EXISTS "${patched}/.gm-patch-applied")
        file(MAKE_DIRECTORY "${patched}")
        # Archive Git blobs rather than copying a Windows CRLF working tree.
        # This also prevents uncommitted submodule edits entering a clean build.
        if(from_source_archive)
            file(COPY "${upstream}/" DESTINATION "${patched}" PATTERN ".gm-source-manifest.json" EXCLUDE)
        else()
        set(archive "${CMAKE_CURRENT_BINARY_DIR}/_deps/${name}-${revision}.tar")
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${upstream}" archive --format=tar "--output=${archive}" "${revision}"
            RESULT_VARIABLE archived)
        if(NOT archived EQUAL 0)
            message(FATAL_ERROR "Could not archive pinned ${name} sources")
        endif()
        execute_process(COMMAND "${CMAKE_COMMAND}" -E tar xf "${archive}"
            WORKING_DIRECTORY "${patched}" RESULT_VARIABLE extracted)
        if(NOT extracted EQUAL 0)
            message(FATAL_ERROR "Could not extract pinned ${name} sources")
        endif()
        endif()
        # Keep Git from discovering the enclosing source worktree. When it does,
        # an absolute --directory path is treated as an unmatched path prefix on
        # Windows: git apply exits successfully but changes zero files.
        execute_process(COMMAND "${CMAKE_COMMAND}" -E env
                "GIT_CEILING_DIRECTORIES=${CMAKE_CURRENT_BINARY_DIR}/_deps"
                "${GIT_EXECUTABLE}" apply --ignore-space-change --unsafe-paths "${patch}"
            WORKING_DIRECTORY "${patched}" RESULT_VARIABLE applied)
        if(NOT applied EQUAL 0)
            message(FATAL_ERROR "Could not apply ${name} compatibility patch in build tree")
        endif()
        file(WRITE "${patched}/.gm-patch-applied" "${revision}\n${patch_hash}\n")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${patch}")
    set(${output_variable} "${patched}" PARENT_SCOPE)
endfunction()
ttrpg_patched_dependency(imgui a28cb615ff2c2ed8901397b00762d557cae24760 TTRPG_IMGUI_DIR)
ttrpg_patched_dependency(glfw 63a7e8b7f82497b0459acba5c1ce7f39aa2bc0e8 TTRPG_GLFW_DIR)
